// src/lib/api/NAME.ts

const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api';

/**
 * NAME 資料型別
 */
export interface NAME {
id: string;
createdAt: string;
updatedAt: string;
// TODO: 新增業務欄位
}

/**
 * 建立 NAME 的請求資料
 */
export interface CreateNAMERequest {
// TODO: 定義必填欄位
}

/**
 * 更新 NAME 的請求資料
 */
export interface UpdateNAMERequest {
// TODO: 定義可更新欄位
}

/**
 * 分頁查詢參數
 */
export interface ListNAMEParams {
page?: number;
limit?: number;
sort?: string;
order?: 'asc' | 'desc';
// TODO: 新增篩選條件
}

/**
 * 分頁回應資料
 */
export interface ListNAMEResponse {
data: NAME[];
total: number;
page: number;
limit: number;
}

/**
 * API 錯誤處理
 */
class APIError extends Error {
constructor(
public status: number,
message: string,
public data?: unknown
) {
super(message);
this.name = 'APIError';
}
}

/**
 * 處理 API 回應
 */
async function handleResponse<T>(response: Response): Promise<T> {
if (!response.ok) {
const errorData = await response.json().catch(() => null);
throw new APIError(
response.status,
errorData?.message || response.statusText,
errorData
);
}
return response.json();
}

/**
 * 取得單一 NAME
 * @param id - 資源 ID
 * @returns NAME 資料
 */
export async function getNAME(id: string): Promise<NAME> {
const response = await fetch(`${API_BASE_URL}/NAME/${id}`);
return handleResponse<NAME>(response);
}

/**
 * 取得 NAME 列表（分頁）
 * @param params - 查詢參數
 * @returns 分頁資料
 */
export async function listNAME(params?: ListNAMEParams): Promise<ListNAMEResponse> {
const searchParams = new URLSearchParams();
if (params?.page) searchParams.set('page', params.page.toString());
if (params?.limit) searchParams.set('limit', params.limit.toString());
if (params?.sort) searchParams.set('sort', params.sort);
if (params?.order) searchParams.set('order', params.order);

const url = `${API_BASE_URL}/NAME?${searchParams.toString()}`;
const response = await fetch(url);
return handleResponse<ListNAMEResponse>(response);
}

/**
 * 建立 NAME
 * @param data - 建立資料
 * @returns 建立的 NAME
 */
export async function createNAME(data: CreateNAMERequest): Promise<NAME> {
const response = await fetch(`${API_BASE_URL}/NAME`, {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(data)
});
return handleResponse<NAME>(response);
}

/**
 * 更新 NAME
 * @param id - 資源 ID
 * @param data - 更新資料
 * @returns 更新後的 NAME
 */
export async function updateNAME(id: string, data: UpdateNAMERequest): Promise<NAME> {
const response = await fetch(`${API_BASE_URL}/NAME/${id}`, {
method: 'PUT',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(data)
});
return handleResponse<NAME>(response);
}

/**
 * 部分更新 NAME
 * @param id - 資源 ID
 * @param data - 部分更新資料
 * @returns 更新後的 NAME
 */
export async function patchNAME(id: string, data: Partial<UpdateNAMERequest>): Promise<NAME> {
const response = await fetch(`${API_BASE_URL}/NAME/${id}`, {
method: 'PATCH',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(data)
});
return handleResponse<NAME>(response);
}

/**
 * 刪除 NAME
 * @param id - 資源 ID
 */
export async function deleteNAME(id: string): Promise<void> {
const response = await fetch(`${API_BASE_URL}/NAME/${id}`, {
method: 'DELETE'
});
await handleResponse<void>(response);
}

/**
 * 批次刪除 NAME
 * @param ids - 資源 ID 陣列
 */
export async function bulkDeleteNAME(ids: string[]): Promise<void> {
const response = await fetch(`${API_BASE_URL}/NAME/bulk-delete`, {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify({ ids })
});
await handleResponse<void>(response);
}
